{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "desserbee-web: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "NODE_OPTIONS='--inspect' yarn next dev",
      "cwd": "${workspaceFolder}/apps/desserbee-web"
    },
    // {
    //   "name": "Next.js: debug client-side",
    //   "type": "chrome",
    //   "request": "launch",
    //   "url": "http://localhost:3000/landing/english"
    // },
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}